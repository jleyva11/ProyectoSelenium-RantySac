<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Suite Tests">
    <listeners>
        <listener class-name="com.nopcommerce.listeners.TestListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl" value="http://localhost:3000/#/login"/>
    <test thread-count="5" name="Tests">
        <groups>
            <run>
                <include name="regression"/>
                <include name="functional"/>
                <include name="integration"/>
            </run>
        </groups>
        <classes>

            <class name="com.nopcommerce.tests.RegisterTest"/>
            <class name="com.nopcommerce.tests.LoginTest"/>
            <class name="com.nopcommerce.tests.OrderTest"/>

        </classes>
    </test>
</suite>